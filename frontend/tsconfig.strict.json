{
  // Ratchet-конфиг (#712): флаги строже базового tsconfig, у которых есть
  // существующий долг. Проверяется scripts/ci/ts-strict-ratchet.sh — долг
  // зафиксирован в .ts-strict-baseline.json и может только уменьшаться.
  // Когда долг флага выжжен до нуля — переносить флаг в tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
