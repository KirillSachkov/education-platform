{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=education_platform;Username=postgres;Password=postgres;Search Path=assignment_review,public"
  },
  "Authentication": {
    "Authority": "http://localhost/",
    "ValidIssuers": ["http://localhost/"],
    "ValidAudiences": ["education-platform"]
  },
  "AssignmentReview": {
    "GitHub": {
      "Slug": "",
      "AppId": 0,
      "ClientId": "",
      "PrivateKeyPemBase64": "",
      "WebhookSecret": ""
    }
  },
  "AssignmentReviewAI": {
    "ReviewEnabled": false,
    "Reviewer": {
      "Model": "deepseek/deepseek-v4-pro",
      "Temperature": 0.2,
      "MaxOutputTokens": 16000,
      "TimeoutSeconds": 300
    },
    "ReviewerBasePrompt": "Если студент оставил в PR/диффе вопросы или TODO к ревьюеру — ответь на них в summary или inline-комментах.",
    "Limits": {
      "MaxDiffAdditions": 1500,
      "MaxIterationsPerSubmission": 20,
      "MaxIterationsPerUserPerDay": 100,
      "MaxIterationsPerAuthorPerDay": 500,
      "MaxInlineComments": 12
    },
    "RepoContext": {
      "Enabled": false,
      "MaxExtraRounds": 2,
      "MaxTotalFiles": 8,
      "MaxFilesPerRound": 5,
      "MaxFileBytes": 51200,
      "MaxManifestFiles": 5,
      "MaxManifestBytes": 16384,
      "MaxTreeChars": 12000
    }
  }
}
