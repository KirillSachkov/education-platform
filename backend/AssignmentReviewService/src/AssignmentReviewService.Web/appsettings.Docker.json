{
  "Cors": {
    "AllowedOrigins": [
      "http://nginx",
      "http://frontend:3000",
      "http://localhost:3000",
      "http://localhost"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AuthServiceOptions": {
    "Url": "http://auth-service:8005",
    "TimeoutSeconds": 7
  },
  "AllowedHosts": "*",
  "AI": {
    "Default": "aitunnel",
    "Providers": {
      "aitunnel": {
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.aitunnel.ru/v1/",
        "TimeoutSeconds": 900
      }
    }
  }
}
