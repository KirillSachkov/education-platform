{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      },
      {
        "Name": "Debug"
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://otel-collector:4317",
          "Protocol": "Grpc",
          "ResourceAttributes": {
            "service.name": "SearchService"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "ConnectionStrings": {
    "Database": "Server=postgres;Port=5432;Database=search_service_db;User Id=postgres;Password=postgres;",
    "RabbitMq": "amqp://guest:guest@rabbitmq:5672",
    "Redis": "redis:6379,abortConnect=false"
  },
  "TypesenseOptions": {
    "Url": "http://typesense:8108"
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 30
  },
  "FileServiceOptions": {
    "Url": "http://file-service:8002/",
    "TimeoutSeconds": 7
  },
  "TagServiceOptions": {
    "Url": "http://tag-service:8007",
    "TimeoutSeconds": 30
  },
  "SearchReindexOptions": {
    "ExportBatchSize": 500,
    "ImportBatchSize": 500,
    "ReindexGeneration": 5,
    "ForceReindexOnStartup": false,
    "Reconciliation": {
      "Enabled": false,
      "Interval": "1.00:00:00",
      "MinIntervalSinceLast": "12:00:00"
    }
  }
}
