{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://localhost:80",
      "http://localhost:3000",
      "http://localhost:5173"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://localhost:8005/",
    "ValidIssuers": [
      "http://localhost:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://localhost:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Database=education_platform;Search Path=material_processing,public;User Id=postgres;Password=postgres;",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "FileServiceOptions": {
    "Url": "http://localhost:8002",
    "TimeoutSeconds": 30
  },
  "EducationServiceOptions": {
    "Url": "http://localhost:8001",
    "TimeoutSeconds": 30
  },
  "VideoProcessing": {
    "ChunkSeconds": 600,
    "MaxVideoDurationMinutes": 180,
    "DefaultLanguage": "ru",
    "AudioSpeedup": 1.2
  },
  "Timecodes": {
    "MinGapBetweenTimecodesSeconds": 45
  },
  "Ffmpeg": {
    "BinaryPath": "ffmpeg",
    "ProbeBinaryPath": "ffprobe",
    "ProcessTimeoutSeconds": 1800
  },
  "AI": {
    "Default": "aitunnel",
    "Providers": {
      "aitunnel": {
        "Kind": "OpenAiCompatible",
        "ApiKey": "",
        "BaseUrl": "https://api.aitunnel.ru/v1/",
        "TimeoutSeconds": 900
      }
    }
  },
  "VideoProcessingAI": {
    "SpeechToText": {
      "Provider": "aitunnel",
      "Model": "gpt-4o-mini-transcribe",
      "Temperature": 0,
      "TimeoutSeconds": 900,
      "MaxOutputTokens": 4000
    },
    "TimecodeGeneration": {
      "Provider": "aitunnel",
      "Model": "gpt-4.1-mini",
      "Temperature": 0.1,
      "TimeoutSeconds": 300,
      "MaxOutputTokens": 6000
    },
    "ContentGeneration": {
      "Provider": "aitunnel",
      "Model": "gpt-5-mini",
      "Temperature": 0.2,
      "TimeoutSeconds": 300,
      "MaxOutputTokens": 8000
    }
  }
}
