{
  "Cors": {
    "AllowedOrigins": [
      "http://nginx",
      "http://frontend:3000",
      "http://localhost:3000",
      "http://localhost"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AllowedHosts": "*",
  "FileServiceOptions": {
    "Url": "http://file-service:8002",
    "TimeoutSeconds": 30
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 30
  },
  "VideoProcessing": {
    "ChunkSeconds": 600,
    "MaxVideoDurationMinutes": 180,
    "DefaultLanguage": "ru",
    "AudioSpeedup": 1.2
  },
  "Timecodes": {
    "MinGapBetweenTimecodesSeconds": 45
  },
  "Ffmpeg": {
    "BinaryPath": "ffmpeg",
    "ProbeBinaryPath": "ffprobe",
    "ProcessTimeoutSeconds": 1800
  },
  "AI": {
    "Default": "aitunnel",
    "Providers": {
      "aitunnel": {
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.aitunnel.ru/v1/",
        "TimeoutSeconds": 900
      }
    }
  },
  "VideoProcessingAI": {
    "SpeechToText": {
      "Provider": "aitunnel",
      "Model": "gpt-4o-mini-transcribe",
      "Temperature": 0,
      "TimeoutSeconds": 900,
      "MaxOutputTokens": 4000
    },
    "TimecodeGeneration": {
      "Provider": "aitunnel",
      "Model": "gpt-4.1-mini",
      "Temperature": 0.1,
      "TimeoutSeconds": 300,
      "MaxOutputTokens": 6000
    },
    "ContentGeneration": {
      "Provider": "aitunnel",
      "Model": "gpt-5-mini",
      "Temperature": 0.2,
      "TimeoutSeconds": 300,
      "MaxOutputTokens": 8000
    }
  }
}
