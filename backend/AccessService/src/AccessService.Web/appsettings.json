{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=education_platform;Username=postgres;Password=postgres;Search Path=access,public"
  },
  "Authentication": {
    "Authority": "http://localhost/",
    "ValidIssuers": ["http://localhost/"],
    "ValidAudiences": ["education-platform"]
  },
  "TBank": {
    "BaseUrl": "https://securepay.tinkoff.ru/v2/",
    "HttpTimeoutSeconds": 10,
    "Receipt": {
      "Taxation": "usn_income",
      "DefaultEmail": "no-receipt@platform.local"
    }
  },
  "PaymentsReconciliation": {
    "IntervalSeconds": 30,
    "MinAgeSecondsBeforePoll": 120,
    "MaxPendingHoursBeforeExpire": 24,
    "BatchSize": 50,
    "RetryDeferralSeconds": 300,
    "RefundPollIntervalSeconds": 86400,
    "RefundLookbackDays": 180
  },
  "RecurringChargesSweeper": {
    "SweepInterval": "01:00:00",
    "BatchSize": 200,
    "Enabled": true
  }
}
