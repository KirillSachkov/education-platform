{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "Authentication": {
    "ServiceClient": {
      "TokenUrl": "http://localhost:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AuthServiceOptions": {
    "Url": "http://localhost:8005",
    "TimeoutSeconds": 7
  },
  "EducationServiceOptions": {
    "Url": "http://localhost:8001",
    "TimeoutSeconds": 7
  },
  "TelegramBotServiceOptions": {
    "Url": "http://localhost:8008",
    "TimeoutSeconds": 7
  },
  "DevAuth": { "Enabled": true },
  "TBank": {
    "NotificationUrl": "http://localhost/api/access/webhooks/tbank/",
    "SuccessUrl": "http://localhost/payment/success",
    "FailUrl": "http://localhost/payment/failed"
  },
  "Billing": { "DefaultEnabled": true }
}
