{
  "Cors": {
    "AllowedOrigins": [
      "http://nginx",
      "http://frontend:3000",
      "http://localhost:3000",
      "http://localhost"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "AuthServiceOptions": {
    "Url": "http://auth-service:8005",
    "TimeoutSeconds": 7
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 7
  },
  "TelegramBotServiceOptions": {
    "Url": "http://telegram-bot-service:8008",
    "TimeoutSeconds": 7
  },
  "TBank": {
    "NotificationUrl": "http://localhost/api/access/webhooks/tbank/",
    "SuccessUrl": "http://localhost/payment/success",
    "FailUrl": "http://localhost/payment/failed"
  },
  "PaymentsReconciliation": {
    "IntervalSeconds": 5,
    "MinAgeSecondsBeforePoll": 5
  },
  "Billing": { "DefaultEnabled": true }
}
