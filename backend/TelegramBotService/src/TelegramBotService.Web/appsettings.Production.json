{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "Wolverine": "Information",
        "TelegramBotFlow": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": ["https://sachkov-learn.net"],
    "AllowCredentials": true,
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
  },
  "Authentication": {
    "Authority": "http://nginx/",
    "ValidIssuers": ["https://sachkov-learn.net/", "http://nginx/"],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://nginx/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "Bot": {
    "Mode": "POLLING",
    "TelegramRequestTimeoutSeconds": 0,
    "AllowedUpdates": ["Message", "CallbackQuery", "MyChatMember", "ChatJoinRequest", "ChatMember", "ChannelPost"],
    "HealthCheckPath": "/_tbf/health"
  },
  "TelegramNotification": {
    "FrontendBaseUrl": "https://sachkov-learn.net"
  },
  "AuthServiceOptions": {
    "Url": "http://auth-service:8005",
    "TimeoutSeconds": 7
  },
  "ProgressServiceOptions": {
    "Url": "http://progress-service:8003",
    "TimeoutSeconds": 7
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 7
  },
  "AccessServiceOptions": {
    "Url": "http://access-service:8010",
    "TimeoutSeconds": 7
  },
  "AllowedHosts": "*"
}
