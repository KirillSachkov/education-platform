{
  "Cors": {
    "AllowedOrigins": ["https://sachkov-learn.net"],
    "AllowCredentials": true,
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
  },
  "Authentication": {
    "Authority": "http://nginx/",
    "ValidIssuers": ["https://sachkov-learn.net/", "http://nginx/"],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://nginx/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "FileServiceOptions": {
    "Url": "http://file-service:8002/",
    "TimeoutSeconds": 7
  },
  "ProgressServiceOptions": {
    "Url": "http://progress-service:8003/",
    "TimeoutSeconds": 7
  },
  "AccessService": {
    "Url": "http://access-service:8010/",
    "Timeout": "00:00:03",
    "CacheTtl": "00:05:00"
  },
  "AuthService": {
    "Url": "http://auth-service:8005/",
    "Timeout": "00:00:03",
    "CacheTtl": "00:05:00"
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "AllowedHosts": "*"
}
