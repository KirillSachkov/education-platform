<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\ContentAccess\ContentAccess.Redis\ContentAccess.Redis.csproj"/>
    <ProjectReference Include="..\EducationContentService.Core\EducationContentService.Core.csproj"/>
    <ProjectReference Include="..\EducationContentService.Domain\EducationContentService.Domain.csproj"/>
    <ProjectReference Include="..\EducationContentService.Infrastructure.Postgres\EducationContentService.Infrastructure.Postgres.csproj"/>
    <ProjectReference Include="..\..\..\Shared\Authentication\Authentication.csproj"/>
    <ProjectReference Include="..\..\..\Shared\Observability\Observability.csproj"/>
    <ProjectReference Include="..\..\..\Shared\PlatformBootstrap\PlatformBootstrap.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\Shared\Observability\serilog*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Data-migration scripts embedded into assembly, загружаются DataMigrationRunner'ом -->
    <EmbeddedResource Include="DataMigrations\*.sql" />
    <!-- README в папке — не embed, оставляем как есть для разработки -->
    <None Include="DataMigrations\*.md" />
    <!-- Seed level-test квиза (CLI seed-level-test) — embedded, работает и в Docker, и в тестах -->
    <EmbeddedResource Include="SeedData\level-test.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>    <ProjectReference Include="..\..\..\Shared\Framework\Framework.csproj" />
    <PackageReference Include="Scalar.AspNetCore"/>
  </ItemGroup>
</Project>
