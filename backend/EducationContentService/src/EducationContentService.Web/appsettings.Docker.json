{
  "Cors": {
    "AllowedOrigins": [
      "http://nginx",
      "http://frontend:3000",
      "http://localhost:3000",
      "http://localhost"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": [
      "*"
    ],
    "AllowedMethods": [
      "*"
    ]
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "FileServiceOptions": {
    "Url": "http://file-service:8002/",
    "TimeoutSeconds": 7
  },
  "MaterialProcessingServiceOptions": {
    "Url": "http://material-processing-service:8011/",
    "TimeoutSeconds": 7
  },
  "ProgressServiceOptions": {
    "Url": "http://progress-service:8003/",
    "TimeoutSeconds": 7
  },
  "AccessService": {
    "Url": "http://access-service:8010/",
    "Timeout": "00:00:03",
    "CacheTtl": "00:05:00"
  },
  "AuthService": {
    "Url": "http://auth-service:8005/",
    "Timeout": "00:00:03",
    "CacheTtl": "00:05:00"
  },
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AllowedHosts": "*"
}

