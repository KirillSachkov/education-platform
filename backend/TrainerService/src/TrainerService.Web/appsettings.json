{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=education_platform;Username=postgres;Password=postgres;Search Path=trainer,public",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Authority": "http://localhost/",
    "ValidIssuers": ["http://localhost/"],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "ServiceClient": {
      "TokenUrl": "http://localhost:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "EducationServiceOptions": {
    "Url": "http://localhost:8001/",
    "TimeoutSeconds": 7
  },
  "AuthService": {
    "Url": "http://localhost:8005/"
  },
  "AI": {
    "Default": "aitunnel",
    "Providers": {
      "aitunnel": {
        "Kind": "OpenAiCompatible",
        "BaseUrl": "https://api.aitunnel.ru/v1/",
        "ApiKey": "",
        "TimeoutSeconds": 900
      }
    }
  },
  "TrainerAI": {
    "Transcription": {
      "Model": "whisper-1"
    },
    "Grading": {
      "Model": "gpt-4.1-mini",
      "Temperature": 0.2,
      "MaxOutputTokens": 1500,
      "TimeoutSeconds": 120
    }
  },
  "Trainer": {
    "FreeSamplePercent": 10
  }
}
