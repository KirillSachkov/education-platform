<Project>
  <!-- Force-rebuild marker: bump this comment to trigger CI rebuild of all services
       (Directory.Packages.props is in every service's `changes:` filter). v=4
       (release v1.17.0 full-rebuild 2026-05-31 — выровнять все 14 service-образов на HEAD
       после фикса radiance build-egress; пайплайны 834/835 собрали лишь часть, этот bump
       форсит пересборку всех с уже-починенным .gitlab-ci.yml proxy.)
       (release !172 full-rebuild — align all service images with v1.11.0 tag at HEAD;
       pipeline 605 на CHANGELOG-коммите был отменён до завершения, прод восстановлен
       вручную, но releases/current.env остался на 23f52126 — этот bump прокатит
       pipeline целиком: build всех 12 services + frontend → prepare-release-images
       → deploy-production → smoke + current.env aligned). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- NU1608: WolverineFx.EntityFrameworkCore pulls EF Design 10.0.0 which requires
         CodeAnalysis.Workspaces.MSBuild 4.14.0, but EF Core 10.0.2 resolves Common to 5.0.0.
         This is a transitive dependency mismatch in Wolverine, not our code. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- AWS -->
    <PackageVersion Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.3.22" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.18.5" />
    <!-- Functional Extensions -->
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.6.0" />
    <!-- Image processing: MIT managed wrapper plus matching native Linux runtime. -->
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <!-- AI providers (Shared/AI + Shared/AI.RouterAI) -->
    <PackageVersion Include="OpenAI" Version="2.10.0" />
    <PackageVersion Include="SharpToken" Version="2.0.6" />
    <PackageVersion Include="JsonSchema.Net" Version="9.2.0" />
    <!-- Web Push (VAPID + RFC 8291 payload encryption) — NotificationService WebPush channel (#342) -->
    <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageVersion Include="Lib.AspNetCore.WebPush" Version="2.2.2" />
    <!-- Data Access -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.7" />
    <PackageVersion Include="Npgsql" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!-- Caching -->
    <!-- 10.0.7 — pulls Microsoft.AspNetCore.DataProtection 10.0.7 transitively which fixes
         the critical vuln GHSA-9mv3-2cwr-p262 (NU1904 fail in `dotnet restore`). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.7" />
    <!-- Transitive security pin: DataProtection 10.0.7 permits newer 10.x crypto packages;
         10.0.10 clears the current high-severity NuGet audit findings in restore. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.7" />
    <!-- Background Jobs -->
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.15.1" />
    <PackageVersion Include="Quartz.Serialization.Json" Version="3.15.1" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <!-- Transitive pin: Microsoft.AspNetCore.OpenApi 10.0.7 permits Microsoft.OpenApi 2.x;
         2.7.5 is the first 2.x release patched for GHSA-v5pm-xwqc-g5wc. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
    <!-- Authentication -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
    <!-- Identity & OpenIddict -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.4.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.4.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.4.0" />
    <PackageVersion Include="OpenIddict.Validation.SystemNetHttp" Version="7.4.0" />
    <PackageVersion Include="OpenIddict.Client.WebIntegration" Version="7.4.0" />
    <PackageVersion Include="OpenIddict.Client.SystemNetHttp" Version="7.4.0" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Logging" Version="8.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols" Version="8.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.16.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.16.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.11.8" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
    <!-- Telegram Bot API -->
    <PackageVersion Include="Telegram.Bot" Version="22.9.0" />
    <!-- TelegramBotFlow dependencies -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
    <!-- Validation & DI -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.16.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.16.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.0" />
    <!-- Logging (Serilog) -->
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Exceptions.EntityFrameworkCore" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.XUnit" Version="3.0.5" />
    <!-- API Documentation -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.13.0" />
    <!-- Code Quality (analyzers configured in root Directory.Build.props) -->
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.44" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.24.0.138807" />
    <!-- Testing -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.10.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.10.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.10.0" />
    <PackageVersion Include="Testcontainers.Typesense" Version="4.10.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Typesense" Version="8.1.0" />
    <!-- 5.31.1 → 5.37.2: критичный фикс в 5.36.1/5.36.2 для нашего сценария
         (issue #67/#78): EF Core durable outbox flushil messages ДО transaction commit,
         поэтому DELETE FROM wolverine_outgoing_envelopes на success запускался на
         другом connection и не видел uncommitted INSERT — row оставалась stranded
         для durability agent re-send. Точно объясняет наш baseline 0.02 msg/s + stuck
         envelopes на 2 минуты.
         5.37.2 → 5.39.2: 5.39.0 содержит PR #2677 "Outbox behavior alignment with EF Core
         transaction model" — релевантно burst publish bottleneck'у (NS публикует 50+
         envelope в одной handler-таске, sender pipeline отдавал только первый eagerly,
         остальные ждали recovery sweep OutboxStaleTime — p95 ~43s на TG-доставке).
         5.39.1 — regression fix, 5.39.2 — current. -->
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="5.39.2" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="5.39.2" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="5.39.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.10.0" />
  </ItemGroup>
</Project>
