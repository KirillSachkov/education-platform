{
  "Cors": {
    "AllowedOrigins": ["https://sachkov-learn.net"],
    "AllowCredentials": true,
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
  },
  "Authentication": {
    "Authority": "http://nginx/",
    "ValidIssuers": ["https://sachkov-learn.net/", "http://nginx/"],
    "ValidAudiences": ["education-platform", "service-to-service", "mcp-admin"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://nginx/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "OpenIddict": {
    "Issuer": "https://sachkov-learn.net/",
    "EducationPlatform": {
      "ClientId": "education-platform",
      "DisplayName": "Education Platform",
      "RedirectUri": "https://sachkov-learn.net/api/auth/callback/auth-service",
      "PostLogoutRedirectUris": [
        "https://sachkov-learn.net",
        "https://sachkov-learn.net/login"
      ]
    },
    "ServiceToService": {
      "ClientId": "service-to-service",
      "DisplayName": "Service-to-Service"
    },
    "AdminApi": {
      "ClientId": "mcp-admin",
      "DisplayName": "Platform Admin API (MCP)"
    }
  },
  "Email": {
    "From": "noreply@sachkov-learn.net",
    "FromName": "Sachkov Learn",
    "BypassUnsubscribeForTransactional": true
  },
  "TelegramLinkOptions": {
    "BotUsername": "sachkov_learn_bot"
  },
  "AuthService": {
    "DefaultRole": "platform-participant",
    "FrontendBaseUrl": "https://sachkov-learn.net"
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 7
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "AllowedHosts": "*"
}
