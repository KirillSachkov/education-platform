{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://localhost:80",
      "http://localhost:3000",
      "http://localhost:5173"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://localhost:8005/",
    "ValidIssuers": ["http://localhost/", "http://localhost:8005/"],
    "ValidAudiences": ["education-platform", "service-to-service", "mcp-admin"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://localhost:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "OpenIddict": {
    "Issuer": "http://localhost/",
    "EducationPlatform": {
      "ClientId": "education-platform",
      "Secret": "education-platform-dev-secret",
      "DisplayName": "Education Platform",
      "RedirectUri": "http://localhost:3000/api/auth/callback/auth-service",
      "PostLogoutRedirectUris": [
        "http://localhost:3000",
        "http://localhost:3000/login"
      ]
    },
    "ServiceToService": {
      "ClientId": "service-to-service",
      "Secret": "DEV-ONLY-service-to-service-secret",
      "DisplayName": "Service-to-Service"
    },
    "AdminApi": {
      "ClientId": "mcp-admin",
      "Secret": "DEV-ONLY-mcp-admin-secret",
      "DisplayName": "Platform Admin API (MCP)"
    }
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "From": "noreply@education-platform.local",
    "FromName": "Education Platform",
    "UseSsl": false
  },
  "GitHub": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "TelegramLinkOptions": {
    "BotUsername": "education_platform_bot"
  },
  "EducationServiceOptions": {
    "Url": "http://localhost:8001",
    "TimeoutSeconds": 7
  },
  "AuthService": {
    "DefaultRole": "platform-participant",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Database=education_platform;Search Path=auth,public;User Id=postgres;Password=postgres;",
    "RabbitMq": "amqp://guest:guest@localhost:5672",
    "Redis": "localhost:6379"
  }
}

