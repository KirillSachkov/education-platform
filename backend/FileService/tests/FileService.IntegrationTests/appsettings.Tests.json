{
  "ConnectionStrings": {
    "Database": "Host=localhost;Database=file_test;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "FileStorageOptions": {
    "Endpoint": "http://localhost:9000",
    "BucketName": "media",
    "KeyPrefix": "tests",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "WithSsl": false,
    "UploadUrlExpirationMinutes": 60,
    "DownloadUrlExpirationMinutes": 120,
    "ProtectedDownloadUrlExpirationMinutes": 15,
    "MaxConcurrentRequests": 50
  },
  "FilePublicUrlOptions": {
    "BasePath": "/api/files"
  },
  "FileMaintenanceOptions": {
    "PendingUploadTtlMinutes": 60,
    "DraftAssetTtlHours": 24,
    "PendingUploadCleanupIntervalMinutes": 15,
    "DraftCleanupIntervalMinutes": 60,
    "PendingUploadBatchSize": 100,
    "DraftCleanupBatchSize": 100
  },
  "VideoMaintenanceOptions": {
    "VideoUploadTimeoutHours": 24,
    "VideoProcessingTimeoutHours": 6,
    "VideoReconciliationIntervalMinutes": 5,
    "ReconciliationBatchSize": 100
  },
  "AssetRetentionOptions": {
    "DeleteRetryIntervalMinutes": 5,
    "DeleteTtlHours": 24,
    "TombstoneRetentionHours": 72,
    "DeleteRetryBatchSize": 100,
    "PurgeBatchSize": 100,
    "RetentionSweepIntervalMinutes": 15
  },
  "TargetEntityOptions": {
    "AllowedTargetEntityTypes": ["material", "module", "issue", "course", "user", "profile", "collection", "project"]
  },
  "Kinescope": {
    "ApiToken": "test-api-token",
    "ParentId": "test-parent-id",
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 1,
    "TimeoutSeconds": 10,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 5,
    "UploaderBaseUrl": "https://uploader.kinescope.io",
    "ApiBaseUrl": "https://api.kinescope.io",
    "EmbedBaseUrl": "https://kinescope.io"
  }
}
