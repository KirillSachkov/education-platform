{
  "Cors": {
    "AllowedOrigins": ["https://sachkov-learn.net"],
    "AllowCredentials": true,
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
  },
  "Authentication": {
    "Authority": "http://nginx/",
    "ValidIssuers": ["https://sachkov-learn.net/", "http://nginx/"],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://nginx/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 7
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "FileStorageOptions": {
    "Endpoint": "https://storage.yandexcloud.net",
    "ExternalEndpoint": "https://sachkov-learn.net/storage",
    "BucketName": "education-platform-files",
    "ForcePathStyle": true,
    "CorsAllowedOrigins": ["https://sachkov-learn.net"],
    "KeyPrefix": "production",
    "WithSsl": true,
    "UploadUrlExpirationMinutes": 60,
    "DownloadUrlExpirationMinutes": 120,
    "ProtectedDownloadUrlExpirationMinutes": 15,
    "MaxConcurrentRequests": 50
  },
  "FilePublicUrlOptions": {
    "BasePath": "/api/files"
  },
  "FileMaintenanceOptions": {
    "PendingUploadTtlMinutes": 60,
    "DraftAssetTtlHours": 24,
    "PendingUploadCleanupIntervalMinutes": 15,
    "DraftCleanupIntervalMinutes": 60,
    "PendingUploadBatchSize": 100,
    "DraftCleanupBatchSize": 100
  },
  "VideoMaintenanceOptions": {
    "VideoUploadTimeoutHours": 24,
    "VideoProcessingTimeoutHours": 6,
    "VideoReconciliationIntervalMinutes": 5,
    "ReconciliationBatchSize": 100
  },
  "AssetRetentionOptions": {
    "DeleteRetryIntervalMinutes": 5,
    "DeleteTtlHours": 24,
    "TombstoneRetentionHours": 72,
    "DeleteRetryBatchSize": 100,
    "PurgeBatchSize": 100,
    "RetentionSweepIntervalMinutes": 15
  },
  "TargetEntityOptions": {
    "AllowedTargetEntityTypes": ["material", "module", "issue", "course", "user", "profile", "collection", "project"]
  },
  "Kinescope": {
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 1,
    "TimeoutSeconds": 30,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "UploaderBaseUrl": "https://uploader.kinescope.io",
    "ApiBaseUrl": "https://api.kinescope.io",
    "EmbedBaseUrl": "https://kinescope.io"
  },
  "AllowedHosts": "*"
}
