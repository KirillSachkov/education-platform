{
  "Cors": {
    "AllowedOrigins": [
      "http://nginx",
      "http://frontend:3000",
      "http://localhost:3000",
      "http://localhost"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 7
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "FileStorageOptions": {
    "Endpoint": "http://minio:9000",
    "ExternalEndpoint": "http://localhost/storage",
    "CorsAllowedOrigins": ["http://localhost"],
    "BucketName": "media",
    "KeyPrefix": "docker",
    "AccessKey": "",
    "SecretKey": "",
    "WithSsl": false,
    "UploadUrlExpirationMinutes": 60,
    "DownloadUrlExpirationMinutes": 10080,
    "ProtectedDownloadUrlExpirationMinutes": 15,
    "MaxConcurrentRequests": 50
  },
  "FilePublicUrlOptions": {
    "BasePath": "/api/files"
  },
  "FileMaintenanceOptions": {
    "PendingUploadTtlMinutes": 60,
    "DraftAssetTtlHours": 24,
    "PendingUploadCleanupIntervalMinutes": 15,
    "DraftCleanupIntervalMinutes": 60,
    "PendingUploadBatchSize": 100,
    "DraftCleanupBatchSize": 100
  },
  "VideoMaintenanceOptions": {
    "VideoUploadTimeoutHours": 24,
    "VideoProcessingTimeoutHours": 6,
    "VideoReconciliationIntervalMinutes": 5,
    "ReconciliationBatchSize": 100
  },
  "AssetRetentionOptions": {
    "DeleteRetryIntervalMinutes": 5,
    "DeleteTtlHours": 24,
    "TombstoneRetentionHours": 72,
    "DeleteRetryBatchSize": 100,
    "PurgeBatchSize": 100,
    "RetentionSweepIntervalMinutes": 15
  },
  "TargetEntityOptions": {
    "AllowedTargetEntityTypes": [
      "material",
      "module",
      "issue",
      "course",
      "user",
      "profile",
      "collection",
      "project"
    ]
  },
  "Kinescope": {
    "ApiToken": "",
    "ParentId": "",
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 1,
    "TimeoutSeconds": 30,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "UploaderBaseUrl": "https://uploader.kinescope.io",
    "ApiBaseUrl": "https://api.kinescope.io",
    "EmbedBaseUrl": "https://kinescope.io"
  }
}
