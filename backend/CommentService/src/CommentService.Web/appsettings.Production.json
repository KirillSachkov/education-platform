{
  "Cors": {
    "AllowedOrigins": ["https://sachkov-learn.net"],
    "AllowCredentials": true,
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
  },
  "Authentication": {
    "Authority": "http://nginx/",
    "ValidIssuers": ["https://sachkov-learn.net/", "http://nginx/"],
    "ValidAudiences": ["education-platform", "service-to-service"],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://nginx/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "ConnectionStrings": {
    "Redis": "redis:6379"
  },
  "CommentRateLimit": {
    "CreatePermitLimit": 10,
    "CreateWindowMinutes": 1
  },
  "AuthServiceOptions": {
    "Url": "http://auth-service:8005",
    "TimeoutSeconds": 7
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001",
    "TimeoutSeconds": 7
  },
  "AllowedHosts": "*"
}
