{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "Authentication": {
    "Authority": "http://localhost:8005/",
    "ValidIssuers": [
      "http://localhost:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://localhost:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Database=education_platform;Search Path=comments,public;User Id=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "CommentRateLimit": {
    "CreatePermitLimit": 10,
    "CreateWindowMinutes": 1
  },
  "EducationServiceOptions": {
    "Url": "http://localhost:8001",
    "TimeoutSeconds": 7
  }
}
