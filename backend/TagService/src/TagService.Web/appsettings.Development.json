{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      },
      {
        "Name": "Debug"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "http://localhost:8005/",
    "ValidIssuers": [
      "http://localhost:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://localhost:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "Wolverine": {
    "Mock": true
  },
  "ConnectionStrings": {
    "Database": "Server=localhost;Port=5434;Database=education_platform;Search Path=tags,public;User Id=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "EducationServiceOptions": {
    "Url": "http://localhost:8001/",
    "TimeoutSeconds": 7
  }
}
