{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Query": "Debug",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
        "System": "Information",
        "System.Net.Http.HttpClient": "Information",
        "Application": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {SourceContext:l} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      },
      {
        "Name": "Debug"
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://otel-collector:4317",
          "Protocol": "Grpc",
          "ResourceAttributes": {
            "service.name": "TagService"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId",
      "WithExceptionDetails"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://nginx",
      "http://frontend:3000",
      "http://localhost:3000",
      "http://localhost"
    ],
    "AllowCredentials": true,
    "AllowedHeaders": ["*"],
    "AllowedMethods": ["*"]
  },
  "EducationServiceOptions": {
    "Url": "http://education-service:8001/",
    "TimeoutSeconds": 7
  },
  "Authentication": {
    "Authority": "http://auth-service:8005/",
    "ValidIssuers": [
      "http://localhost/",
      "http://localhost:8005/",
      "http://auth-service:8005/"
    ],
    "ValidAudiences": [
      "education-platform",
      "service-to-service"
    ],
    "RequireHttpsMetadata": false,
    "ServiceClient": {
      "TokenUrl": "http://auth-service:8005/connect/token",
      "ClientId": "service-to-service"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "redis:6379"
  }
}
