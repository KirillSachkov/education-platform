[Unit]
Description=Education platform availability, disk and backup check
After=docker.service network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/education-platform/scripts/ops/production/check_health.py --config /etc/education-platform/monitor.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
