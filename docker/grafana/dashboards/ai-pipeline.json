{
  "uid": "ai-pipeline",
  "title": "AI Pipeline",
  "tags": ["ai-pipeline", "platform"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(ai_request_duration_seconds_count, ai_model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput & latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AI request duration p50/p95/p99",
      "description": "End-to-end длительность LLM-вызова через MeteredAiClient. Skip rate-limit ретраи, peak = модель тормозит или пик трафика.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_request_duration_seconds_bucket{ai_model=~\"$model\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_request_duration_seconds_bucket{ai_model=~\"$model\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(ai_request_duration_seconds_bucket{ai_model=~\"$model\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AI requests per second by outcome",
      "description": "RPS LLM-вызовов в разрезе finish_reason. Tag outcome = stop|length|content_filter|tool_calls|error.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(ai_requests_total{ai_model=~\"$model\"}[5m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Truncation defense (issue #110)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Truncations per minute by job",
      "description": "Сколько раз AI-вызов вернул finish_reason=length (или эквивалент по STT-эвристике). Tag job: STT|TIMECODES|CONTENT, level: глубина recursion'а / номер retry. Высокий показатель → MaxOutputTokens мал для конкретного вида контента, переключи модель или подними лимит.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "sum by (job, level) (rate(ai_truncations_total[1m])) * 60", "legendFormat": "{{job}}/level={{level}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "STT chunk splits per minute",
      "description": "Сколько раз ffmpeg делил mp3-чанк пополам из-за обрезанного STT-результата. Высокий показатель — модель не справляется с плотной речью.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "refId": "A", "expr": "sum (rate(ai_chunk_splits_total[1m])) * 60", "legendFormat": "splits/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Tokens & cost",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Input tokens / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "targets": [
        { "refId": "A", "expr": "sum by (ai_model) (rate(ai_input_tokens_total{ai_model=~\"$model\"}[5m]))", "legendFormat": "{{ai_model}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Output tokens / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "targets": [
        { "refId": "A", "expr": "sum by (ai_model) (rate(ai_output_tokens_total{ai_model=~\"$model\"}[5m]))", "legendFormat": "{{ai_model}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Audio bytes processed / sec (STT)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "targets": [
        { "refId": "A", "expr": "sum (rate(ai_transcription_audio_bytes_total[5m]))", "legendFormat": "audio bytes/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "binBps", "min": 0 } }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Wolverine outbox / queue depth",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "id": 13,
      "type": "stat",
      "title": "AI request rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "sum (rate(ai_requests_total{outcome!=\"error\"}[5m])) * 60", "legendFormat": "req/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Error rate %",
      "description": "Доля LLM-вызовов с outcome=error за последние 5 минут. >10% за 10 минут — алерт.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "100 * sum(rate(ai_requests_total{outcome=\"error\"}[5m])) / sum(rate(ai_requests_total[5m]))", "legendFormat": "error rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } } }
    }
  ]
}
