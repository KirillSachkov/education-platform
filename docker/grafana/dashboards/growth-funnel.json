{
  "annotations": {
    "list": []
  },
  "description": "Server-authoritative billing metrics: checkout, paid orders, and order outcomes. Browser acquisition events and UTMs remain in Yandex Metrica; Prometheus panels intentionally cover only backend-confirmed actions.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "id": 4,
      "title": "Paid orders · 24h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(increase(payments_order_paid_total[24h])) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Checkout → paid · 24h",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Windowed approximation based on backend-created orders and backend-confirmed PAID transitions.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * (sum(increase(payments_order_paid_total[24h])) or vector(0)) / clamp_min(sum(increase(payments_order_created_total[24h])) or vector(0), 1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "title": "Order outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(increase(payments_order_created_total[1h]))",
          "legendFormat": "created",
          "refId": "A"
        },
        {
          "expr": "sum(increase(payments_order_paid_total[1h]))",
          "legendFormat": "paid",
          "refId": "B"
        },
        {
          "expr": "sum(increase(payments_order_failed_total[1h]))",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "growth-funnel",
    "business",
    "billing"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Growth Funnel",
  "uid": "growth-funnel",
  "version": 1,
  "weekStart": ""
}
