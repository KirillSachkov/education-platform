{
  "uid": "postgres-platform",
  "title": "PostgreSQL — Connections & Queries",
  "tags": ["platform", "postgres", "infra"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active Connections / Limit",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(pg_stat_database_numbackends)", "legendFormat": "active", "refId": "A" },
        { "expr": "pg_settings_max_connections", "legendFormat": "max", "refId": "B" }
      ]
    },
    {
      "id": 2,
      "title": "Connections Saturation (%)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "targets": [{
        "expr": "100 * sum(pg_stat_database_numbackends) / scalar(pg_settings_max_connections)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "DB Size",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [{
        "expr": "pg_database_size_bytes{datname=\"education_platform\"}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 4,
      "title": "Commits / Rollbacks per second",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=\"education_platform\"}[1m]))", "legendFormat": "{{datname}} commit", "refId": "A" },
        { "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=\"education_platform\"}[1m]))", "legendFormat": "{{datname}} rollback", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "title": "Tuples Read / Inserted / Updated / Deleted",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_tup_returned{datname=\"education_platform\"}[1m]))", "legendFormat": "read", "refId": "A" },
        { "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"education_platform\"}[1m]))", "legendFormat": "inserted", "refId": "B" },
        { "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"education_platform\"}[1m]))", "legendFormat": "updated", "refId": "C" },
        { "expr": "sum(rate(pg_stat_database_tup_deleted{datname=\"education_platform\"}[1m]))", "legendFormat": "deleted", "refId": "D" }
      ]
    },
    {
      "id": 6,
      "title": "Deadlocks (24h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 6 },
      "targets": [{
        "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"education_platform\"}[24h]))",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Cache Hit Ratio (shared_buffers)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 6 },
      "targets": [{
        "expr": "sum(pg_stat_database_blks_hit) / clamp_min(sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read), 1)",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 8,
      "title": "Locks Count (by mode)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "targets": [{
        "expr": "sum by (mode) (pg_locks_count)",
        "legendFormat": "{{mode}}",
        "refId": "A"
      }]
    }
  ]
}
