{
  "uid": "rabbitmq",
  "title": "RabbitMQ — Queues & Outbox",
  "tags": ["platform", "rabbitmq", "messaging", "wolverine"],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Ready Messages per Queue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (queue) (rabbitmq_queue_messages_ready)",
        "legendFormat": "{{queue}}",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "Unacked Messages per Queue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (queue) (rabbitmq_queue_messages_unacked)",
        "legendFormat": "{{queue}}",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "title": "Publish vs Deliver Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total[1m]))", "legendFormat": "ack/s", "refId": "A" },
        { "expr": "sum(rate(rabbitmq_global_messages_delivered_total[1m]))", "legendFormat": "deliver/s", "refId": "B" },
        { "expr": "sum(rate(rabbitmq_global_messages_received_total[1m]))", "legendFormat": "publish/s", "refId": "C" }
      ]
    },
    {
      "id": 4,
      "title": "Consumers per Queue",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (queue) (rabbitmq_queue_consumers)",
        "legendFormat": "{{queue}}",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Queues with Zero Consumers (alert source)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 6 },
      "targets": [{
        "expr": "count(rabbitmq_queue_consumers == 0 and rabbitmq_queue_messages_ready > 0) or vector(0)",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "RMQ Memory Used",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 6 },
      "targets": [{
        "expr": "rabbitmq_process_resident_memory_bytes",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "title": "DLQ depth (wolverine-dead-letter-queue)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "targets": [{
        "expr": "rabbitmq_queue_messages{queue=\"wolverine-dead-letter-queue\"}",
        "legendFormat": "DLQ",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    }
  ]
}
