# Platform Admin MCP — environment variables.
# Copy to .env and fill in secrets.

# Base URL of the platform (where nginx listens).
# Dev:  http://localhost
# Prod: https://sachkov-learn.net
PLATFORM_BASE_URL=http://localhost

# OIDC client credentials for the mcp-admin client.
# Dev default secret is set via docker-compose / appsettings.Development.json.
MCP_CLIENT_ID=mcp-admin
MCP_CLIENT_SECRET=DEV-ONLY-mcp-admin-secret

# Log level: trace | debug | info | warn | error.
LOG_LEVEL=info
