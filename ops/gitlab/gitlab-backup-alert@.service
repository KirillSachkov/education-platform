[Unit]
Description=Send a Telegram alert for failed GitLab backup unit %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=GITLAB_BACKUP_ALERT_ENV_FILE=/etc/gitlab-backup/alert.env
EnvironmentFile=/etc/gitlab-backup/alert.env
ExecStart=/usr/local/sbin/gitlab-backup-alert.sh %i
TimeoutStartSec=2m30s
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
