# -----------------------------------------------------------------------------
# Development environment secrets.
# cp .env.example .env — then optionally customize values.
# Frontend: run ./scripts/dev.sh gen-fe-env to generate frontend/.env.local
#
# Non-secret config lives in appsettings.Docker.json per service.
# Only secrets and infrastructure credentials belong here.
# -----------------------------------------------------------------------------

# --- Infrastructure ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Database connections ---
COMMENT_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=comments,public;User Id=postgres;Password=postgres;
EDUCATION_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=education,public;User Id=postgres;Password=postgres;
FILE_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=files,public;User Id=postgres;Password=postgres;
PROGRESS_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=progress,public;User Id=postgres;Password=postgres;
AUTH_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=auth,public;User Id=postgres;Password=postgres;
TAG_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=tags,public;User Id=postgres;Password=postgres;
NOTIFICATION_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=notifications,public;User Id=postgres;Password=postgres;
TELEGRAM_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=telegrambot,public;User Id=postgres;Password=postgres;
SEARCH_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=search,public;User Id=postgres;Password=postgres;
ACCESS_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=access,public;User Id=postgres;Password=postgres;
MATERIAL_PROCESSING_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=material_processing,public;User Id=postgres;Password=postgres;
ASSIGNMENT_REVIEW_DB_CONNECTION=Server=postgres;Port=5432;Database=education_platform;Search Path=assignment_review,public;User Id=postgres;Password=postgres;
CONNECTIONSTRINGS__RABBITMQ=amqp://guest:guest@rabbitmq:5672

# --- AI provider (AITunnel — OpenAI-compatible RU aggregator, issue #146) ---
# Multi-provider абстракция в Shared/AI готова принять новых провайдеров через
# AI:Providers:* словарь в appsettings.{Environment}.json. Сейчас зарегистрирован
# только AITunnel (https://aitunnel.ru) — drop-in OpenAI-compat с dedicated
# /v1/audio/transcriptions endpoint, моделями gpt-4o-mini-transcribe / whisper-1 /
# gpt-4.1-mini. Цены ~₽0.35/min STT, ₽77/307 за 1M LLM tokens.
# Получить ключ: aitunnel.ru → Settings → API keys (пополнить баланс).
# Пустой ApiKey в dev отключает AI-генерацию.
AI__PROVIDERS__AITUNNEL__APIKEY=
TYPESENSE_API_KEY=my-api-key

# --- OAuth / Auth secrets ---
AUTHENTICATION__SERVICECLIENT__CLIENTSECRET=dev-s2s-secret
OPENIDDICT__SERVICETOSERVICE__SECRET=dev-s2s-secret
OPENIDDICT__EDUCATIONPLATFORM__SECRET=dev-platform-secret
OPENIDDICT__ADMINAPI__SECRET=dev-mcp-admin-secret

# --- Admin ---
AUTHSERVICE__DEFAULTADMIN__EMAIL=admin@admin.com
AUTHSERVICE__DEFAULTADMIN__PASSWORD=admin123
# Slug пространства автора для default admin'а. Создаётся idempotently при seed'е,
# совпадает с PRIMARY_AUTHOR_SLUG на фронте. Пусто → space не создаётся.
AUTHSERVICE__DEFAULTADMIN__AUTHORSPACESLUG=sachkov

# --- Signing keys (generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0) ---
SIGNINGKEYS__SIGNINGKEYBASE64=
SIGNINGKEYS__ENCRYPTIONKEYBASE64=

# --- Email (production: Unisender Go HTTP API). В dev Mailpit принимает без auth.
# Единая секция "Email" для AuthService и NotificationService.
# Если EMAIL__APIKEY задан — используется HTTP API, иначе SMTP. ---
EMAIL__USERNAME=
EMAIL__PASSWORD=
EMAIL__APIKEY=

# --- GitHub OAuth (optional, create app at github.com/settings/developers) ---
GITHUB__CLIENTID=
GITHUB__CLIENTSECRET=

# --- GitHub App для авто-приглашения в org (issue #68) ---
# Регистрируется отдельно от OAuth App: github.com → Settings → Developer settings → GitHub Apps → New
# Permissions: Organization → Members: Write. Events: organization, installation.
# Callback URL: https://platform/api/access/integrations/github/install-callback/
# Webhook URL:  https://platform/api/access/webhooks/github
GITHUBAPP__APPID=
GITHUBAPP__SLUG=
GITHUBAPP__CLIENTID=
# base64-encoded private key PEM (из github.com → App settings → Generate a private key)
# в shell: base64 -i private-key.pem | tr -d '\n'
GITHUBAPP__PRIVATEKEYPEMBASE64=
# random 32-byte secret для HMAC-SHA256 verification webhook'ов; сгенерировать через
# `openssl rand -hex 32` и вставить тот же в GitHub App webhook secret
GITHUBAPP__WEBHOOKSECRET=
# куда редиректить автора после установки App (обычно author plan-edit page)
GITHUBAPP__FRONTENDINSTALLRETURNURL=/author/plans

# --- Telegram bot (linking) ---
TELEGRAMLINKOPTIONS__BOTUSERNAME=education_platform_bot

# --- NotificationService: slug автора для построения deep-link'ов нотификаций.
# Bакаются в payload.targetUrl через PlatformLinkBuilder; multi-author — TBD. ---
NOTIFICATIONS__PRIMARYAUTHORSLUG=sachkov

# --- Telegram bot (TelegramBotService runtime; TelegramBotFlow reads Bot:Token) ---
BOT__TOKEN=

# --- S3 credentials (dev: MinIO, must match MINIO_ROOT_USER/PASSWORD) ---
FILESTORAGEOPTIONS__ACCESSKEY=minioadmin
FILESTORAGEOPTIONS__SECRETKEY=minioadmin

# --- Kinescope (optional for dev) ---
KINESCOPE__APITOKEN=
KINESCOPE__PARENTID=

# --- Frontend ---
AUTH_SECRET=dev-secret-generate-with-openssl-rand-base64-32
AUTH_OIDC_ID=education-platform
AUTH_OIDC_SECRET=dev-platform-secret
AUTH_OIDC_ISSUER=http://localhost/
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_AUTH_ORIGIN=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_PRIMARY_AUTHOR_SLUG=sachkov
NEXT_PUBLIC_CONSULTATION_LINK=https://t.me/sachkova_mng

# Yandex.Metrika counter ID. В dev — оставить пустым, скрипт не грузится.
# В prod задать через CI / Infisical. Скрипт грузится только при согласии
# пользователя на analytics-cookies через cookie-banner.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# --- Search-console verification (SEO, issue #530) ---
# Коды подтверждения прав сайта (мета-тег) из Яндекс.Вебмастер / Google Search
# Console. Server-runtime env (НЕ NEXT_PUBLIC) — читается в root layout metadata.
# Пусто => тег не выводится (no-op). Для статичной главной альтернатива —
# HTML-файл в frontend/public/ или DNS-подтверждение (см. issue #531).
YANDEX_VERIFICATION_ID=
GOOGLE_SITE_VERIFICATION_ID=

# --- Web Push (PWA push-уведомления, issue #342) ---
# VAPID keypair. Сгенерировать: npx web-push generate-vapid-keys --json
# PublicKey идёт И на фронт (NEXT_PUBLIC_VAPID_PUBLIC_KEY), И на бэк; PrivateKey — только бэк.
# Если ключи пустые — WebPush-канал не регистрируется (push не доставляется), остальное работает.
# В prod — отдельная пара через Infisical, НЕ переиспользовать dev-ключи.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NOTIFICATIONS__WEBPUSH__SUBJECT=mailto:admin@sachkov-learn.net
NOTIFICATIONS__WEBPUSH__PUBLICKEY=
NOTIFICATIONS__WEBPUSH__PRIVATEKEY=

# --- Observability ---
GF_SECURITY_ADMIN_PASSWORD=admin

# OTEL sampling (0..1). Если задан, переопределяет дефолт (1.0 dev, 0.1 prod).
# OTEL_TRACES_SAMPLER_ARG=0.1

# --- Postgres metrics (read-only user для postgres_exporter) ---
POSTGRES_EXPORTER_PASSWORD=exporter

# --- MinIO (dev only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- S3 Backup (prod only) ---
# Demo input; production uses the approved immutable PostgreSQL digest.
RESTORE_POSTGRES_IMAGE=pgvector/pgvector:pg16
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=education-platform-backups
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net

# -----------------------------------------------------------------------------
# Dev-only: project name + host port overrides.
# Use these when running multiple education-platform clones (или другой проект
# с тем же набором инфры) на одной машине, чтобы избежать конфликтов.
#
# По умолчанию compose project name = "edu-platform" → контейнеры именуются
# "edu-platform-postgres-1" и т.д. Volumes и networks тоже namespaced под него.
# Поменяй COMPOSE_PROJECT_NAME — получишь полностью изолированный стек.
# -----------------------------------------------------------------------------

# COMPOSE_PROJECT_NAME=edu-platform-clone2

# Хост-порты. Раскомментируй и поправь те, что конфликтуют с другим стэком.
# NGINX_HOST_PORT=80
# POSTGRES_HOST_PORT=5434
# REDIS_HOST_PORT=6379
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_UI_PORT=15672
# RABBITMQ_METRICS_PORT=15692
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# TYPESENSE_HOST_PORT=8108
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# FRONTEND_HOST_PORT=3000
# Backend services (по конвенции host port = container port)
# EDUCATION_HOST_PORT=8001
# FILE_HOST_PORT=8002
# PROGRESS_HOST_PORT=8003
# COMMENT_HOST_PORT=8004
# AUTH_HOST_PORT=8005
# NOTIFICATION_HOST_PORT=8006
# TAG_HOST_PORT=8007
# TELEGRAM_HOST_PORT=8008
# SEARCH_HOST_PORT=8009
# ACCESS_HOST_PORT=8010
# ASSIGNMENT_REVIEW_HOST_PORT=8012
# Observability
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
# OTEL_PROM_PORT=8889
# PG_EXPORTER_PORT=9187
# REDIS_EXPORTER_PORT=9121
# ALLOY_PORT=12345
# TEMPO_PORT=3200
# LOKI_PORT=3100
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# --- AssignmentReviewService GitHub App (issue #15) ---
# Регистрируется ОТДЕЛЬНО от GITHUBAPP__* (org-invitations) и от
# GITHUB__CLIENTID/SECRET (OAuth login). Permissions:
# Pull requests Read & write, Contents Read-only, Metadata Read-only.
# Webhook events: installation, installation_target.
# Webhook URL: https://platform/api/assignment-review/webhooks/github
# Используется в Phase 4+ (Phase 2 — skeleton, секреты ещё не читаются).
ASSIGNMENTREVIEW__GITHUB__APPID=
ASSIGNMENTREVIEW__GITHUB__SLUG=
ASSIGNMENTREVIEW__GITHUB__CLIENTID=
ASSIGNMENTREVIEW__GITHUB__PRIVATEKEYPEMBASE64=
ASSIGNMENTREVIEW__GITHUB__WEBHOOKSECRET=

# --- T-Bank Acquiring (Phase F.1.0+, issue #102) ---
# TerminalKey + Password выдаются в личном кабинете T-Bank (securepay.tinkoff.ru).
# Webhook URL зарегистрировать там же: <NotificationUrl> из appsettings.{Env}.json.
TBANK__TERMINALKEY=
TBANK__PASSWORD=

# Reconciliation: на dev уменьши до 5/5 чтобы оплата подтверждалась за секунды,
# а не за 2+ минуты (на проде webhook доходит — defaults 30/120 ОК).
PAYMENTSRECONCILIATION__INTERVALSECONDS=
PAYMENTSRECONCILIATION__MINAGESECONDSBEFOREPOLL=

# Frontend feature flag для T-Bank checkout. По умолчанию false (юзер видит
# «Оформить через Telegram»). Локально или после прод-cutover — true.
NEXT_PUBLIC_BILLING_ENABLED=false
